font pango:monospace 8

set $mod Mod4

exec --no-startup-id dex --autostart --environment i3
exec --no-startup-id nm-applet
exec --no-startup-id blueman-applet
exec_always --no-startup-id ~/.config/i3/wallpaper-daemon.sh
exec_always --no-startup-id pkill -x picom; picom -b
exec_always --no-startup-id pkill -x autotiling
exec_always --no-startup-id ~/.local/bin/i3grid daemon
exec --no-startup-id copyq
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

floating_modifier $mod
tiling_drag modifier titlebar

set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

bindsym $mod+Return exec kitty
bindsym $mod+Shift+q kill
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym $mod+Shift+d exec --no-startup-id rofi -show run
bindsym $mod+Tab exec --no-startup-id rofi -show window

bindsym $mod+ctrl+l exec --no-startup-id ~/.config/i3/lock.sh

exec_always --no-startup-id setxkbmap us

bindsym $mod+p exec --no-startup-id ~/.config/i3/monitor-menu.sh
bindsym $mod+Shift+p exec --no-startup-id "for output in $(xrandr | grep ' disconnected .* [0-9]' | cut -d' ' -f1); do xrandr --output $output --off; done"

bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+i focus up
bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

set $move ~/.local/bin/i3grid move

bindsym $mod+Shift+j exec --no-startup-id $move left
bindsym $mod+Shift+k exec --no-startup-id $move down
bindsym $mod+Shift+i exec --no-startup-id $move up
bindsym $mod+Shift+l exec --no-startup-id $move right

bindsym $mod+Shift+Left exec --no-startup-id $move left
bindsym $mod+Shift+Down exec --no-startup-id $move down
bindsym $mod+Shift+Up exec --no-startup-id $move up
bindsym $mod+Shift+Right exec --no-startup-id $move right

bindsym $mod+b split h
bindsym $mod+v split v
bindsym $mod+x exec --no-startup-id ~/.config/i3/scripts/swap.sh
bindsym $mod+g exec --no-startup-id ~/.local/bin/i3grid flip

bindsym $mod+f fullscreen toggle

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle
bindsym $mod+ctrl+space focus mode_toggle

bindsym $mod+a focus parent

bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

bindsym $mod+space exec --no-startup-id "setxkbmap -query | grep -q 'layout:     us' && setxkbmap br || setxkbmap us; pkill -SIGRTMIN+11 i3blocks"

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+ctrl+1 move container to workspace number $ws1; workspace number $ws1
bindsym $mod+ctrl+2 move container to workspace number $ws2; workspace number $ws2
bindsym $mod+ctrl+3 move container to workspace number $ws3; workspace number $ws3
bindsym $mod+ctrl+4 move container to workspace number $ws4; workspace number $ws4
bindsym $mod+ctrl+5 move container to workspace number $ws5; workspace number $ws5
bindsym $mod+ctrl+6 move container to workspace number $ws6; workspace number $ws6
bindsym $mod+ctrl+7 move container to workspace number $ws7; workspace number $ws7
bindsym $mod+ctrl+8 move container to workspace number $ws8; workspace number $ws8
bindsym $mod+ctrl+9 move container to workspace number $ws9; workspace number $ws9
bindsym $mod+ctrl+0 move container to workspace number $ws10; workspace number $ws10

bindsym $mod+o exec --no-startup-id flameshot gui
bindsym $mod+Print exec --no-startup-id flameshot full -p ~/Imagens
bindsym Shift+Print exec --no-startup-id flameshot gui --clipboard

bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Deseja sair do i3?' -B 'Sim, sair' 'i3-msg exit'"

mode "resize" {
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym i resize shrink height 10 px or 10 ppt
        bindsym l resize grow width 10 px or 10 ppt

        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

client.focused          #252525 #FFFFFF #252525 #FFFFFF   #FFFFFF
client.focused_inactive #252525 #252525 #FFFFFF #484E50   #666666
client.unfocused        #252525 #252525 #888888 #292D2E   #222222
client.urgent           #2F343A #461B27 #FFFFFF #461B27   #461B27
client.placeholder      #000000 #0C0C0C #FFFFFF #000000   #0C0C0C
client.background       #FFFFFF

for_window [class=".*"] border pixel 2
gaps inner 15
smart_gaps off
smart_borders on

for_window [class="(?i)flameshot"] floating enable, border none
for_window [class="(?i)copyq"] floating enable
for_window [class="(?i)pavucontrol"] floating enable
for_window [class="(?i)blueman-manager"] floating enable
for_window [class="(?i)nm-connection-editor"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="Preferences"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable

bar {
    colors {
        background #000000
        statusline #FFFFFF
        separator  #666666
        focused_workspace  #252525 #FFFFFF #252525
        active_workspace   #333333 #222222 #FFFFFF
        inactive_workspace #333333 #222222 #888888
        urgent_workspace   #2F343A #461B27 #FFFFFF
        binding_mode       #2F343A #CD4F72 #FFFFFF
    }
    status_command i3blocks
    position top
    tray_output primary
}

include ~/.config/i3/local.conf
